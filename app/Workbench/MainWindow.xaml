<Window x:Class="TSKHook.Workbench.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TSKHook · 翻译工作台" Width="1320" Height="980" MinWidth="1080" MinHeight="880" Background="#F2F5FA" Foreground="#24324A" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Grid Background="#F2F5FA">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
    <Border Background="White" Padding="24,18" BorderBrush="#E0E6EF" BorderThickness="0,0,0,1">
      <DockPanel>
        <Border DockPanel.Dock="Right" Background="#EAF0FF" CornerRadius="12" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="维护者工作台 · 0.5.2" Foreground="#3459D6"/></Border>
        <StackPanel><TextBlock Text="TSKHook  /  翻译工作台" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="收集新文本，处理需要你判断的内容，再发布给所有玩家。" Margin="0,5,0,0" Foreground="#748098"/></StackPanel>
      </DockPanel>
    </Border>
    <UniformGrid Grid.Row="1" Columns="4" Margin="24,18,12,18">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="文本总数（位置）" Foreground="#748098"/><TextBlock x:Name="AllCount" Text="—" FontSize="27" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="可自动翻译（任务）" Foreground="#748098"/><TextBlock x:Name="PendingCount" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#3459D6"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="需要收尾（任务）" Foreground="#748098"/><TextBlock x:Name="ReviewCount" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#A56813"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="可编译译文（位置）" Foreground="#748098"/><TextBlock x:Name="ReadyCount" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#23816D"/></StackPanel></Border>
    </UniformGrid>
    <Border Grid.Row="2" Margin="24,0,24,14" Padding="16,12" Background="#EAF0FF" CornerRadius="6">
      <StackPanel>
        <DockPanel><TextBlock x:Name="TranslationElapsed" DockPanel.Dock="Right" Foreground="#5D6B83"/><TextBlock x:Name="TranslationStatus" Text="尚未开始翻译" FontWeight="SemiBold" FontSize="15"/></DockPanel>
        <StackPanel x:Name="TranslationDetails" Visibility="Collapsed">
        <TextBlock x:Name="TranslationCounts" Text="点击“翻译待办”后，这里会显示任务进度。" Margin="0,6,0,6" TextWrapping="Wrap"/>
        <ProgressBar x:Name="TranslationBar" Height="7" Minimum="0" Maximum="1" Value="0" Foreground="#3459D6"/>
        <TextBlock x:Name="TranslationActivity" Text="模型按批返回结果；等待期间进度不增长属于正常情况。" Margin="0,6,0,0" Foreground="#5D6B83" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <TabControl x:Name="Pages" Grid.Row="3" Margin="24,0,24,10" BorderBrush="#DCE3ED" Background="White">
      <TabItem Header="工作队列">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <Button Content="扫描捕获" Click="Import_Click"/><Button x:Name="TranslateButton" Content="翻译待办" Style="{StaticResource Primary}" Click="Translate_Click"/>
            <Button x:Name="RetryButton" Content="重试失败任务" Click="Retry_Click"/><Button x:Name="PauseButton" IsEnabled="False" Content="暂停任务" Click="Pause_Click"/>
            <CheckBox x:Name="AutoImport" Content="自动归档" IsChecked="True"/><CheckBox x:Name="AutoTranslate" Content="自动翻译" ToolTip="定期将新增文本发送给配置的模型接口；会产生接口用量。"/>
            <CheckBox x:Name="MergeDuplicates" Content="合并重复 / 编号模板" IsChecked="True" Click="Merge_Changed" ToolTip="同源文本合并；同字段的塔层名称归为 {floor} 模板。取消可按单个位置修订。"/>
            <Button Content="复用已有译文" Click="Reuse_Click"/><Button Content="重新校验" Click="Recheck_Click" ToolTip="仅将校验已通过的非空待核对译文恢复为机器初译，不标为人工审校，不调用模型。"/>
            <Button x:Name="BulkUnifyButton" Content="模型批量统一" Click="BulkUnify_Click" ToolTip="调用核对模型处理整个工作目录的译文分歧，自动选择并保存已有候选；不覆盖人工确认内容。会产生模型用量。"/>
            <Button x:Name="BulkCheckButton" Content="模型批量核对" Click="BulkCheck_Click" ToolTip="调用核对模型判断整个工作目录的待修正项，自动保留或修正；不确定的保留待处理。会产生模型用量。"/>
          </WrapPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock x:Name="ModelRoleSummary" Foreground="#3459D6" Margin="0,0,0,6" TextWrapping="Wrap"/><TextBlock x:Name="QueueSummary" Foreground="#5D6B83" Margin="0,0,0,8" TextWrapping="Wrap"/><DockPanel>
            <ComboBox x:Name="Filter" Width="160" DockPanel.Dock="Left" SelectionChanged="Filter_Changed" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="收尾总览"/><ComboBoxItem Content="可自动翻译"/><ComboBoxItem Content="译文待统一"/><ComboBoxItem Content="译文待修正"/><ComboBoxItem Content="捕获冲突"/><ComboBoxItem Content="已人工审校"/><ComboBoxItem Content="已排除"/><ComboBoxItem Content="全部文本"/><ComboBoxItem Content="模型已核对"/></ComboBox>
            <TextBlock x:Name="ResultCount" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#748098"/>
            <TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="搜索原文、译文、分类或 key"/>
          </DockPanel></StackPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Rows_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F5" BorderBrush="#E1E6EF" AlternatingRowBackground="#F8FAFD" RowHeight="36" EnableRowVirtualization="True">
              <DataGrid.Columns><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="64"/><DataGridTextColumn Header="处理方式" Binding="{Binding ActionLabel}" Width="95"/><DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="80"/><DataGridTextColumn Header="位置" Binding="{Binding PositionCount}" Width="48"/><DataGridTextColumn Header="原文" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="问题" Binding="{Binding Issues}" Width="60"/></DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" BorderBrush="#E1E6EF" BorderThickness="1" Padding="10" CornerRadius="4">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="NextStep" Text="选择条目查看处理建议。" TextWrapping="Wrap" Foreground="#3459D6" Margin="2,0,2,10"/>
                <TabControl x:Name="ReviewTabs" Grid.Row="1">
                  <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="10,8"/></Style></TabControl.Resources>
                  <TabItem Header="编辑译文">
                    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="原文" FontWeight="SemiBold" Margin="0,0,0,6"/>
                      <TextBox Grid.Row="1" x:Name="Original" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="#F6F8FC"/>
                      <TextBlock Grid.Row="2" Text="中文译文" FontWeight="SemiBold" Margin="0,8,0,6"/>
                      <TextBox Grid.Row="3" x:Name="EditedTranslation" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Editor_Changed"/>
                      <TextBlock Grid.Row="4" x:Name="EntryInfo" TextWrapping="Wrap" Foreground="#748098" FontSize="11" MaxHeight="42" Margin="0,6,0,6"/>
                      <WrapPanel Grid.Row="5"><Button x:Name="SaveReviewButton" Content="保存审校" Click="SaveEntry_Click" ToolTip="只保存当前选中组。非致命告警经你核对后视为已确认。"/><Button x:Name="SelectedCheckButton" Content="模型核对当前组" Click="SelectedCheck_Click" ToolTip="使用核对模型保留或修正本组译文，并记录理由。"/><Button x:Name="RetranslateButton" Content="重译当前组" Click="Retranslate_Click" ToolTip="仅发送当前组选中位置，会产生模型用量；人工审校、冲突和受保护字段不可重译。"/><Button x:Name="ExcludeEntryButton" Content="排除此组" Click="Exclude_Click"/><Button Content="实机确认" Click="VerifyEntry_Click" ToolTip="仅记录已在游戏验证的单个位置，不用于替代译文审校。"/></WrapPanel>
                    </Grid>
                  </TabItem>
                  <TabItem Header="已有译文">
                    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock x:Name="CandidateSummary" TextWrapping="Wrap" Foreground="#5D6B83" Margin="0,0,0,8"/>
                      <ListBox x:Name="CandidateList" Grid.Row="1" SelectionChanged="Candidate_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Summary}" Foreground="#748098" FontSize="11"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,5,0,0" ToolTip="{Binding Locations}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                      </ListBox>
                      <WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="AdoptCandidateButton" Content="采用到编辑框" IsEnabled="False" Click="AdoptCandidate_Click"/><Button x:Name="SelectedUnifyButton" Content="模型选择并统一" Click="SelectedUnify_Click" ToolTip="使用核对模型选择已有候选，自动统一同原文的非人工位置。"/><Button x:Name="UnifyCandidateButton" Content="统一同原文译文…" IsEnabled="False" Click="UnifyCandidate_Click"/></WrapPanel>
                    </Grid>
                  </TabItem>
                  <TabItem Header="问题与冲突">
                    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBox x:Name="IssueDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                      <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="复制详情" Click="CopyDetails_Click"/><Button Content="修复捕获身份" Click="RepairIdentity_Click" ToolTip="备份后修复已知名称、页签和技能变体的旧身份；保留全部原文，不调用模型。"/><Button x:Name="ExcludeConflictButton" Content="暂不发布该冲突组…" IsEnabled="False" Click="ExcludeConflict_Click"/></WrapPanel>
                    </Grid>
                  </TabItem>
                </TabControl>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="模型与路径">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24,8,24,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="工作目录" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="WorkspaceBrowse_Click" Margin="8,0,0,0"/><TextBox x:Name="WorkspacePath"/></DockPanel>
            <TextBlock Text="选择 TSKHook-UITranslations 仓库根目录。" Foreground="#748098" Margin="0,5,0,0"/>
            <TextBlock Text="游戏目录" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="GameBrowse_Click" Margin="8,0,0,0"/><TextBox x:Name="GamePath"/></DockPanel>
            <TextBlock Text="捕获目录" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="CaptureBrowse_Click" Margin="8,0,0,0"/><TextBox x:Name="CapturePath"/></DockPanel>
            <TextBlock Text="工作台关闭时插件仍然捕获；下次打开自动补处理。" Foreground="#748098" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock Text="GitHub 发布凭据" Style="{StaticResource Label}"/><PasswordBox x:Name="GitHubToken"/>
            <TextBlock Text="需要翻译仓库的 Contents 写入权限；Git 推送使用本机 Git 凭据。" Foreground="#748098" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <UniformGrid Columns="3" Margin="0,0,0,18"><StackPanel Margin="0,0,10,0"><TextBlock Text="每批条数" Style="{StaticResource Label}"/><TextBox x:Name="BatchSize" Text="8"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="并发数" Style="{StaticResource Label}"/><TextBox x:Name="Concurrency" Text="2"/></StackPanel><StackPanel><TextBlock Text="输出上限" Style="{StaticResource Label}"/><TextBox x:Name="MaxTokens" Text="8192"/></StackPanel></UniformGrid>
            <WrapPanel><Button Content="保存设置并加载" Style="{StaticResource Primary}" Click="SaveSettings_Click"/><Button Content="重新加载工作目录" Click="Reload_Click"/></WrapPanel>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <UniformGrid Columns="2" Margin="0,0,0,8">
              <StackPanel Margin="0,0,10,0"><TextBlock Text="初翻模型" Style="{StaticResource Label}"/><ComboBox x:Name="InitialModelChoice" DisplayMemberPath="Label" SelectionChanged="RoleModel_Changed" ToolTip="初翻和重译使用此模型"/></StackPanel>
              <StackPanel><TextBlock Text="核对模型" Style="{StaticResource Label}"/><ComboBox x:Name="ReviewModelChoice" DisplayMemberPath="Label" SelectionChanged="RoleModel_Changed" ToolTip="统一候选、判断与修正使用此模型"/></StackPanel>
            </UniformGrid>
            <TextBlock Text="供应商" Style="{StaticResource Label}"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="新增" Click="AddProvider_Click" Margin="8,0,0,0"/><ComboBox x:Name="ProviderList" DisplayMemberPath="Name" SelectionChanged="Provider_Changed"/></DockPanel>
            <TextBlock Text="供应商名称" Style="{StaticResource Label}"/><TextBox x:Name="ProviderName"/>
            <TextBlock Text="接口（完整 chat/completions 地址）" Style="{StaticResource Label}"/><TextBox x:Name="Endpoint"/>
            <TextBlock Text="保存的模型名称（每行一个）" Style="{StaticResource Label}"/><TextBox x:Name="SavedModelNames" Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="此供应商的 API Key" Style="{StaticResource Label}"/><PasswordBox x:Name="ModelKey"/>
            <TextBlock Text="凭据仅保存在本机，用当前 Windows 账户加密，不写入翻译仓库。" Foreground="#748098" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <Button Content="保存供应商与模型列表" Click="SaveProvider_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            <TextBlock Text="规则与术语从 translations/ui 中读取；模型输出经过校验后才写回。任务失败不会反复自动重试，可在工作队列中主动重试。" Foreground="#748098" TextWrapping="Wrap" Margin="0,14,0,0"/>
          </StackPanel>
        </Grid></ScrollViewer>
      </TabItem>
      <TabItem Header="预览与发布">
        <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="先在本机确认，再让玩家获取更新" FontSize="19" FontWeight="SemiBold"/>
          <WrapPanel Grid.Row="1" Margin="0,18,0,14"><TextBlock Text="版本" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="Version" Width="190" Margin="0,0,18,0"/><TextBlock Text="GitHub 仓库" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="Repository" Width="320" Text="Azure-Sora/TSKHook-UITranslations"/></WrapPanel>
          <StackPanel Grid.Row="2"><WrapPanel><Button Content="生成技能正式文本" Click="GenerateSkills_Click"/><Button Content="编译并检查" Click="Compile_Click"/><Button Content="安装到本机预览" Click="Preview_Click"/><Button Content="发布翻译更新…" Style="{StaticResource Primary}" Click="Publish_Click"/><Button Content="打开输出目录" Click="OpenPackage_Click"/></WrapPanel><TextBlock Text="编译时自动补齐技能正式文本：去掉已翻译升级预览的 color 标签，保留原数值，不推算未捕获等级。预览后在游戏 F1 设置中开启“本地预览模式”。" Foreground="#748098" TextWrapping="Wrap" Margin="0,12,0,14"/></StackPanel>
          <TextBox Grid.Row="3" x:Name="PackageSummary" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="#F7F9FC" Text="编译后显示条目数、校验结果和包版本。发布前可在这里检查本次结果。"/>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="4" Margin="24,0,24,16" Padding="12,8" Background="#E8EDF5" CornerRadius="6"><TextBox x:Name="LogOutput" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#5D6B83" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
